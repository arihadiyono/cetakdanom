<UserControl x:Class="CetakDanom.Desktop.Views.DanomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cascading Filter Bar -->
            <RowDefinition Height="Auto"/> <!-- Search & Summary Bar -->
            <RowDefinition Height="*"/>    <!-- Data Grid & Detail Panel -->
            <RowDefinition Height="Auto"/> <!-- Action Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: CASCADING FILTER BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PARAMETER WILAYAH &amp; PROGRAM PENYALURAN (CASCADING FILTER)" 
                           FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Layanan -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Jenis Layanan Bansos" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding LayananList}" SelectedItem="{Binding SelectedLayanan, Mode=TwoWay}" DisplayMemberPath="Nama"/>
                    </StackPanel>

                    <!-- Tahap -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tahap" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding TahapList}" SelectedItem="{Binding SelectedTahap, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Provinsi -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Provinsi" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding ProvinsiList}" SelectedItem="{Binding SelectedProvinsi, Mode=TwoWay}" DisplayMemberPath="Nama"/>
                    </StackPanel>

                    <!-- Kabupaten -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Kabupaten / Kota" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding KabupatenList}" SelectedItem="{Binding SelectedKabupaten, Mode=TwoWay}" DisplayMemberPath="Nama"/>
                    </StackPanel>

                    <!-- Kecamatan -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Kecamatan" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding KecamatanList}" SelectedItem="{Binding SelectedKecamatan, Mode=TwoWay}" DisplayMemberPath="Nama"/>
                    </StackPanel>

                    <!-- Kelurahan -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Desa / Kelurahan" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding KelurahanList}" SelectedItem="{Binding SelectedKelurahan, Mode=TwoWay}" DisplayMemberPath="Nama"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 1: SEARCH, FILTER STATUS & KPI SUMMARY -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cari Nama KPM / NIK / ID Pelanggan:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding ResetFilterCommand}" VerticalAlignment="Bottom" Height="32" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Mini Summary KPI -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Total KPM" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalRecords}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Total Nominal BSU" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.TotalNominalFormatted}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PosOrangeBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Siap Cetak" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.SiapCetakCount}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="Sudah Cetak" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Summary.SudahCetakCount}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: DATAGRID & DETAIL DRAWER -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Main DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding PenerimaList}" 
                          SelectedItem="{Binding SelectedPenerima, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="0"
                          RowHeight="36"
                          HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Danom" Binding="{Binding Danom}" Width="60"/>
                        <DataGridTextColumn Header="NIK KPM" Binding="{Binding Nik}" Width="150"/>
                        <DataGridTextColumn Header="Nama Penerima (KPM)" Binding="{Binding Nama}" Width="180"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="200"/>
                        <DataGridTextColumn Header="Kelurahan" Binding="{Binding Kelurahan}" Width="110"/>
                        <DataGridTextColumn Header="Nominal (Rp)" Binding="{Binding NominalFormatted}" Width="100"/>
                        <DataGridTextColumn Header="Tahap" Binding="{Binding Tahap}" Width="60"/>
                        
                        <!-- Status Danom Badge -->
                        <DataGridTemplateColumn Header="Status Danom" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusDanom, Converter={StaticResource StatusBgConverter}}"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusDanomDisplay}" 
                                                   Foreground="{Binding StatusDanom, Converter={StaticResource StatusBrushConverter}}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Bukti Terima Badge -->
                        <DataGridTemplateColumn Header="Kuitansi" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBuktiTerima, Converter={StaticResource StatusBgConverter}}"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBuktiDisplay}" 
                                                   Foreground="{Binding StatusBuktiTerima, Converter={StaticResource StatusBrushConverter}}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Selected Record Detail Side Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DETAIL KPM TERPILIH" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,12"/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="ID Pelanggan (19+1 Digit):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.IdPelanggan}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Nomor Induk Kependudukan (NIK):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.Nik}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PosOrangeBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Nama Lengkap:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.Nama}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Alamat Domisili:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.Alamat}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Alamat Sesuai KTP:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.AlamatKtp}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Wilayah Administrasi:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.Kelurahan, StringFormat='{}Kel. {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedPenerima.Kecamatan, StringFormat='{}Kec. {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedPenerima.Kabupaten}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Nominal Bantuan (BSU):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedPenerima.NominalFormatted, StringFormat='{}Rp {0}'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PosOrangeBrush}"/>
                        </StackPanel>

                        <Separator Margin="0,8,0,12"/>

                        <TextBlock Text="AKSI KPM INI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <Button Content="Cetak Kuitansi (Bukti Bayar)" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding CetakBuktiCommand}" Margin="0,0,0,8"/>

                        <Button Content="Cetak Surat Pernyataan (SPTJM)" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding CetakSuratCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 3: ACTION FOOTER BAR & STATUS -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource NavyDarkBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Ekspor BNBA (.CSV)" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding ExportBnbaCommand}" Margin="0,0,10,0"/>

                    <Button Content="Cetak Dokumen Danom (Semua)" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding CetakDanomCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
