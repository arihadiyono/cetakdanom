<UserControl x:Class="CetakDanom.Desktop.Views.CetakDanomSatuanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Input NIK Panel (Identik CDS.exe Panel6) -->
            <RowDefinition Height="Auto"/> <!-- Data Details Panel (Identik CDS.exe Labels) -->
            <RowDefinition Height="*"/>    <!-- DataGrid BT (Identik CDS.exe griddata_bt) -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons (Cetak & Preview) & Status -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="MENU 4: CETAK DANOM SATUAN (POLA CDS.EXE LOKET)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}"/>
                <TextBlock Text="Inquiry data penerima susulan berdasarkan NIK tunggal (BLT BBM, BSU Pekerja, dll) dan cetak kuitansi tanda terima loket."
                           Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- INPUT NIK PANEL (Meniru Panel6 pada CDS.exe) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="NOMOR INDUK KEPENDUDUKAN (NIK) *" FontWeight="Bold" FontSize="12" 
                           Foreground="{StaticResource NavyDarkBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBox Grid.Column="1" Text="{Binding InputNik, UpdateSourceTrigger=PropertyChanged}" 
                         FontFamily="Consolas" FontSize="15" FontWeight="Bold" Height="38" Padding="8,6" 
                         MaxLength="20" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="AMBIL DATA" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding AmbilDataCommand}" Height="38" Padding="18,0" FontWeight="Bold" Margin="0,0,8,0"/>

                <Button Grid.Column="3" Content="RESET" Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding ResetCommand}" Height="38" Padding="16,0" FontWeight="Bold"/>

                <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource PosOrangeBrush}" 
                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- DATA DETAILS PANEL (Identik dengan form layout CDS.exe) -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: NIK, Nama, BSU/Nominal -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                    <TextBlock Text="NIK KPM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelNik}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,12">
                    <TextBlock Text="NAMA LENGKAP KPM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelNama}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="BESAR UANG / BSU" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelBsu}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PosOrangeBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Row 1: No Voucher, Perusahaan, Alamat Perusahaan -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12">
                    <TextBlock Text="NO VOUCHER" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelNoVoucher}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,12">
                    <TextBlock Text="NAMA PERUSAHAAN / INSTANSI" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelNmPerusahaan}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="ALAMAT PERUSAHAAN / LOKASI" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LabelAlamatPerusahaan}" FontSize="12" Foreground="#334155" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Row 2: Hierarki Wilayah -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="HIERARKI WILAYAH PENYALURAN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LabelProv, StringFormat='{}Prov: {0}  |  '}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                        <TextBlock Text="{Binding LabelKab, StringFormat='{}Kab/Kota: {0}  |  '}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                        <TextBlock Text="{Binding LabelKec, StringFormat='{}Kec: {0}  |  '}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                        <TextBlock Text="{Binding LabelKel, StringFormat='{}Kel/Desa: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID BUKTI TERIMA SATUAN (griddata_bt pada CDS.exe) -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding GridDataBt}" AutoGenerateColumns="False" IsReadOnly="True" 
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID PELANGGAN" Binding="{Binding IdPelanggan}" Width="140"/>
                    <DataGridTextColumn Header="NIK KPM" Binding="{Binding Nik}" Width="160"/>
                    <DataGridTextColumn Header="NAMA LENGKAP" Binding="{Binding Nama}" Width="200"/>
                    <DataGridTextColumn Header="ALAMAT KPM" Binding="{Binding AlamatDtks}" Width="260"/>
                    <DataGridTextColumn Header="NOMINAL (RP)" Binding="{Binding Nominal, StringFormat='{}{0:N0}'}" Width="130"/>
                    <DataGridTextColumn Header="PROGRAM BANTUAN" Binding="{Binding Program}" Width="180"/>
                    <DataGridTextColumn Header="NO VOUCHER" Binding="{Binding NoVoucher}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOTTOM ACTION BAR: CETAK & PREVIEW (Identik dengan btnCetakBT & btnPreviewBT pada CDS.exe) -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pencetakan Kuitansi Bukti Terima (FastReport &amp; QR Code 2D)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                    <TextBlock Text="Dilengkapi barcode 2D pipe-delimited 6 segmen yang kompatibel dengan scanner loket pos" FontSize="11" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&amp;Preview Kuitansi" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding PreviewBtCommand}" Padding="18,10" FontWeight="Bold" Margin="0,0,12,0"/>
                    <Button Content="&amp;Cetak Kuitansi Loket" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding CetakBtCommand}" Padding="20,10" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
