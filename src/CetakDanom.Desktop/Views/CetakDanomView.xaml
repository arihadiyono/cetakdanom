<UserControl x:Class="CetakDanom.Desktop.Views.CetakDanomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- Toolbar: Search, Filter, Action Buttons -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="MENU 2: CETAK DANOM &amp; EKSPOR BNBA" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}"/>
                    <TextBlock Text="Tampilkan daftar nominatif KPM, cetak dokumen Danom resmi (20 baris per halaman), dan buat file CSV BNBA."
                               Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Buat File BNBA (CSV)" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding ExportBnbaCommand}" Margin="0,0,10,0" Padding="14,8" FontWeight="Bold"/>
                    <Button Content="Pratinjau Format Danom" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding PreviewDanomCommand}" Margin="0,0,10,0" Padding="14,8" FontWeight="Bold"/>
                    <Button Content="Cetak ke Printer" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding CetakDanomCommand}" Padding="14,8" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL KPM" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalKpm}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL NOMINAL" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalNominal, StringFormat='{}Rp {0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosOrangeBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BELUM CETAK" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding BelumCetakCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SUDAH CETAK" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SudahCetakCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TOOLBAR: SEARCH & FILTER -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cari NIK / Nama:" Style="{StaticResource FormLabelStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Filter Status:" Style="{StaticResource FormLabelStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding SelectedStatusFilter}" Width="150" Height="32" VerticalAlignment="Center">
                        <x:Null/>
                        <ComboBoxItem Content="Semua Status" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Segarkan Data" Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="12,6"/>
            </DockPanel>
        </Border>

        <!-- DATAGRID KPM (Meniru griddata TbvDBGrid Delphi) -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredRecords}" SelectedItem="{Binding SelectedPenerima}" 
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO DANOM" Binding="{Binding Danom}" Width="90"/>
                    <DataGridTextColumn Header="NIK" Binding="{Binding Nik}" Width="160"/>
                    <DataGridTextColumn Header="NAMA KPM" Binding="{Binding Nama}" Width="200"/>
                    <DataGridTextColumn Header="ALAMAT KPM" Binding="{Binding Alamat}" Width="240"/>
                    <DataGridTextColumn Header="KELURAHAN" Binding="{Binding Kelurahan}" Width="120"/>
                    <DataGridTextColumn Header="NOMINAL (RP)" Binding="{Binding Nominal, StringFormat='{}{0:N0}'}" Width="120"/>
                    <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="110"/>
                    <DataGridTemplateColumn Header="STATUS CETAK" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" 
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Aturan: Presisi cetak 20 baris per halaman | Delimiter BNBA: Titik Koma (;) | Prefix NIK: Backtick (`)" 
                           Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
