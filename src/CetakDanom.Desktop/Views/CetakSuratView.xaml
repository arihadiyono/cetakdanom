<UserControl x:Class="CetakDanom.Desktop.Views.CetakSuratView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Selector Panel: Parameter & KPM -->
            <RowDefinition Height="*"/>    <!-- Split View: KPM List on Left, Surat Preview on Right -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="MENU 3: CETAK SURAT PEMBERITAHUAN PENERIMA BANTUAN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}"/>
                    <TextBlock Text="Menghasilkan surat pemberitahuan / undangan resmi KPM dengan parameter klausul dari param_xxx.pos dan logo instansi logoxxx.jpg."
                               Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Pratinjau Dokumen Cetak" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding PreviewSuratCommand}" Margin="0,0,10,0" Padding="14,8" FontWeight="Bold"/>
                    <Button Content="Cetak Surat Terpilih" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding CetakSuratCommand}" Margin="0,0,10,0" Padding="14,8" FontWeight="Bold"/>
                    <Button Content="Cetak Semua Surat (Batch)" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding CetakSemuaSuratCommand}" Padding="14,8" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SELECTOR PANEL (Parameter & Logo File) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Berkas Parameter Surat (param_xxx.pos) *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ParameterList}" SelectedItem="{Binding SelectedParameter}" DisplayMemberPath="DisplayName" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Logo Perusahaan / Instansi Terdeteksi" Style="{StaticResource FormLabelStyle}"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Height="36">
                        <TextBlock Text="{Binding SelectedParameter.LogoFileName, StringFormat='{}Logo: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyDarkBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Logo Mitra / Kementerian" Style="{StaticResource FormLabelStyle}"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Height="36">
                        <TextBlock Text="{Binding SelectedParameter.LogoInstansiFileName, StringFormat='{}Mitra: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyDarkBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SPLIT CONTENT: KPM LIST & SURAT PREVIEW -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- Left: List of KPMs -->
                <ColumnDefinition Width="16"/>  <!-- Spacer -->
                <ColumnDefinition Width="*"/>   <!-- Right: Live Letter Preview -->
            </Grid.ColumnDefinitions>

            <!-- KPM LIST -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Daftar Penerima Bantuan (Pilih KPM):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding KpmList}" SelectedItem="{Binding SelectedKpm}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Nama}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                                            <TextBlock Text="{Binding Nominal, StringFormat='{}Rp {0:N0}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PosOrangeBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Nik, StringFormat='{}NIK: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- LIVE SURAT PREVIEW (Meniru layout cetak kuitansi / surat Delphi) -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderSlateBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Pratinjau Format Surat Pemberitahuan KPM:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyDarkBrush}"/>
                        <TextBlock Text="Format Resmi Cetak Surat Pos Indonesia" FontSize="11" Foreground="{StaticResource PosOrangeBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16">
                            <TextBox Text="{Binding SuratPreviewText}" FontFamily="Courier New" FontSize="12" 
                                     Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER / STATUS -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Kompatibel dengan FastReport frxReportBT &amp; format param_xxx.pos asli" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
