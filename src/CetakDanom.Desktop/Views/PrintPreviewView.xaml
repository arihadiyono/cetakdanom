<UserControl x:Class="CetakDanom.Desktop.Views.PrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Action -->
            <RowDefinition Height="*"/>    <!-- Preview Content Area -->
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource NavyDarkBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding HeaderInfo}" FontSize="11" Foreground="{StaticResource PosOrangeBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Kembali ke Danom" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding BackCommand}" Margin="0,0,10,0"/>

                    <Button Content="Simulasikan Cetak Fisik" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding SimulatePrintCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Preview Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Printable Formatted Document (Simulated Paper) -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Feedback alert banner if simulated print is triggered -->
                    <Border Grid.Row="0" Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding HasPrintFeedback, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding PrintFeedbackMessage}" Foreground="#166534" FontWeight="SemiBold" FontSize="12"/>
                    </Border>

                    <!-- Monospace Pre-formatted Paper Layout (Preserving 20-row Danom / Kuitansi layout) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding FormattedContent, Mode=OneWay}" 
                                 FontFamily="Consolas, Courier New, monospace" 
                                 FontSize="12" 
                                 IsReadOnly="True" 
                                 BorderThickness="0" 
                                 Background="Transparent"
                                 TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- QR Code Inspector Panel (If Bukti Terima) -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Width="340"
                    Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVisConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="INSPEKSI BARCODE 2D (QR CODE)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,12"/>

                        <!-- QR Code Image rendered from QRCoder -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Image Source="{Binding QrImageBytes, Converter={StaticResource BytesToImageConverter}}" 
                                   Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <!-- QR Validation Status -->
                        <Border Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="STATUS VALIDASI KONTRAK" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock Text="VALID (TEPAT 6 SEGMEN BERPEMISAH PIPA)" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding QrValidationMessage}" FontSize="10" Foreground="#166534" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Payload breakdown -->
                        <TextBlock Text="String Payload Asli (Pipe-Delimited):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <TextBox Text="{Binding QrPayload, Mode=OneWay}" 
                                     Foreground="#38BDF8" 
                                     FontFamily="Consolas" 
                                     FontSize="10" 
                                     TextWrapping="Wrap" 
                                     IsReadOnly="True" 
                                     BorderThickness="0" 
                                     Background="Transparent"/>
                        </Border>

                        <TextBlock Text="Struktur 6 Segmen Kontrak Scanner Loket:" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="1. [ID_PELANGGAN_19DIGIT][TAHAP]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="2. [NIK_16DIGIT]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="3. [NAMA_KPM]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="4. [ALAMAT_KTP]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="5. [ALAMAT_DOMISILI]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="6. [BSU_NOMINAL_RIBUAN]" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
