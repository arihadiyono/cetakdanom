<Window x:Class="CetakDanom.Desktop.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CetakDanom.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="CetakDanom Modern FDPOS - PT Pos Indonesia (Persero)"
        Height="660" Width="1100"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgSlateBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Sidebar Navigation -->
            <ColumnDefinition Width="*"/>   <!-- Main Work Area -->
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Brand Header -->
                    <RowDefinition Height="*"/>    <!-- Navigation Menu Items -->
                    <RowDefinition Height="Auto"/> <!-- User Profile & Logout -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PosOrangeBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="POS" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CETAKDANOM" Foreground="White" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="FDPOS MODERN" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu Items (4 Menu Sesuai Alur Delphi Asli) -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU OPERASIONAL LOKET" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,0,0,8"/>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateUnduhDanomCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1. UNDUH DANOM" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCetakDanomCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="2. CETAK DANOM" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCetakSuratCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="3. CETAK SURAT" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCdsCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="4. CETAK DANOM SATUAN" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="#1E293B" Margin="0,16,0,16"/>

                    <TextBlock Text="MODE OPERASI POS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="10,0,0,8"/>
                    
                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Modernisasi FDPOS" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Alur: Menu 1 s.d. Menu 4" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                            <TextBlock Text="CDS: Terintegrasi C#" Foreground="#10B981" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock Text="Mode: Online / Offline F5" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- User Profile & Logout Bottom Section -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{Binding CurrentPetugas.Nama}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentPetugas.Nippos, StringFormat='{}NIPPOS: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentPetugas.Kantor, StringFormat='{}Kantor: {0}'}" Foreground="#CBD5E1" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentPetugas.Nopend, StringFormat='{}NOPEND: {0}'}" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <Button Grid.Row="1" Content="Keluar (Logout)" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" Padding="8,4" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/> <!-- Top Header Bar -->
                <RowDefinition Height="*"/>  <!-- Dynamic Page Content -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}"/>
                        <TextBlock Text="Sistem Operasional Cetak Danom &amp; Penyaluran Bansos FDPOS" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Demo Mode Amber Badge -->
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ModeBadge}" Foreground="#B45309" FontWeight="Bold" FontSize="11"/>
                        </Border>

                        <!-- Version Badge -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,5">
                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Presenter -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
