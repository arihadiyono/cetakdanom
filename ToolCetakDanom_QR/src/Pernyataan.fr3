IK&#34;&#62;+'|'+&#60;frxDBDataset1.&#34;PELANGGAN&#34;&#62;+'|'+&#60;frxDBDataset1.&#34;ALAMAT_KTP&#34;&#62;+'|'+&#60;frxDBDataset1.&#34;ALAMAT&#34;&#62;+'|'+bsu;&#13;&#10;          BarCode1.Text := &#60;frxDBDataset1.&#34;bs1&#34;&#62;;&#13;&#10;       end;&#13;&#10;      //Memo24.Top := 470.00;&#13;&#10;  end;  }&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ColumnHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;  status_g:= &#60;frxDBDataset1.&#34;STATUS_GARUDA&#34;&#62;;&#13;&#10;  idpel:= Copy(&#60;frxDBDataset1.&#34;ID_PELANGGAN&#34;&#62;,1,3);&#13;&#10;&#13;&#10;  {if (idpel='BMU') then&#13;&#10;  begin&#13;&#10;       Picture3.LoadFromFile('logo.jpg');&#13;&#10;  end&#13;&#10;  }&#13;&#10;  idpel := LowerCase(idpel); // idpel := 'bmu';&#13;&#10;  if (status_g = '1') then&#13;&#10;     Picture2.Visible := True;&#13;&#10;&#13;&#10;&#13;&#10;  Picture3.LoadFromFile('logo_'+idpel+'.jpg');&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." OnStartReport="frxReportBTPernyataanOnStartReport">
